---
import fs from 'node:fs';
import path from 'node:path';
import BaseLayout from '../../layouts/BaseLayout.astro';
import entries from '../../data/entries.json';
import topics from '../../data/topics.json';
import { buildBacklinks } from '@/lib/backlinks.ts';

export async function getStaticPaths() {
    return topics.map((topic) => ({
        params: {slug: topic.slug},
        props: {topic},
    }));
}

const {topic} = Astro.props;

const descPath = path.resolve('src/content/topics', topic.descriptionFile);
let descHtml = '';
if (fs.existsSync(descPath)) {
    descHtml = fs.readFileSync(descPath, 'utf-8');
}

const topicEntries = topic.entries
    .map((id) => entries.find((e) => e.yqid === id || e.slug === id))
    .filter((e): e is NonNullable<typeof e> => e != null);

const backlinks = buildBacklinks(entries, topics).get(`topic:${topic.slug}`) || [];
---

<BaseLayout title={topic.title}>
    <h1>{topic.title}</h1>

    <div class="topic-description">
        <Fragment set:html={descHtml}/>
    </div>

    <hr>
    {topicEntries.map((entry) => (
            <article>
                <time>{entry.date}</time>
                <a href={`/entry/${entry.slug}`}>{entry.title}</a>
            </article>
    ))}

    {backlinks.length > 0 && (
        <section>
            <h2>引用</h2>
            <ul>
                {backlinks.map((src) => (
                    <li>
                        <a href={`/${src.type}/${src.slug}`}>{src.title}</a>
                    </li>
                ))}
            </ul>
        </section>
    )}

</BaseLayout>
