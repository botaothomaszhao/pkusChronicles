# Cloudflare R2 凭证（复制为 .env 后填写，.env 已 gitignore 不上传）
# R2_ENDPOINT 格式: https://<accountid>.r2.cloudflarestorage.com/<bucket名>
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=https://r2.pkuschronicles.com

# 语雀站内链接转换前缀（用于将语雀原始 URL 转回站内路由）
YUQUE_BASE_URL=https://pkuschool.yuque.com/xxxx
